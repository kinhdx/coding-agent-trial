# Shared sandbox image: Node 24 for the harness CLIs, uv and Python 3.12 for the target repositories,
# the target repositories cloned with full history, and a uv cache warmed for every task's starting commit
# so that workspaces install without network access.
FROM node:24-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /uvx /usr/local/bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-managed
RUN uv python install 3.12  && git config --system --add safe.directory '*'

RUN for repo in loan-dossier-intake llm-service-starter agent-asset-registry; do \
      git clone -q "https://github.com/kinhdx/$repo" "/opt/src/$repo"; \
    done

COPY sandbox/prepare-workspace.sh sandbox/grade.sh /usr/local/bin/
# COMMITS lists repo@commit for every task start and fix commit (see `trial build`). Dependencies download here;
# the image then sets UV_OFFLINE, so runs and grading install from the cache only.
ARG COMMITS
RUN chmod +x /usr/local/bin/prepare-workspace.sh /usr/local/bin/grade.sh \
 && useradd -m -s /bin/bash agent && mkdir /work && chown agent /work \
 && for rc in $COMMITS; do prepare-workspace.sh "${rc%@*}" "${rc#*@}"; done \
 && find /work -mindepth 1 -delete \
 && chown -R agent /opt/uv-cache /work

USER agent
WORKDIR /work
ENV UV_OFFLINE=1
